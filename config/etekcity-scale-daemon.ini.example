[scale]
# Leave address and model empty to auto-discover a supported scale on first
# run (step on the scale while the daemon is scanning). Once discovered,
# this file is updated automatically so future restarts reconnect directly
# instead of scanning again.
address =
model =

# Optional BLE adapter to use, e.g. hci0 (Linux only). Leave empty for the
# system default adapter.
adapter =

# BLE scanning mode: active or passive (Linux only; other platforms always
# scan actively).
scanning_mode = active

# Seconds to ignore advertisements after a disconnection. Only applies to
# GATT-based scales (ESF-551, ESF-24, EFS-A591S).
cooldown_seconds = 5

[storage]
# Path to the SQLite database file where measurements are recorded.
db_path = /var/lib/etekcity-scale-daemon/measurements.db

[daemon]
# Logging level: DEBUG, INFO, WARNING, ERROR
log_level = INFO

[report]
# Layout for PDF reports (etekcity-scale-report):
#   full   - one row per reading, with the columns below (default)
#   simple - date/weight only, laid out in several side-by-side columns
#            so a page isn't mostly empty
#   chart  - a line chart of weight over time instead of a table
layout = full

# Columns to include in the "full" layout, yes or no.
include_address = yes
include_model = yes
include_impedance = yes

# Heart rate is only reported by the EFS-A591S (Apex HR) model; defaults to
# no so other models don't get a column full of dashes.
include_heart_rate = no

# Show which profile each reading was tagged with (see [profiles] below).
# Defaults to no; mainly useful when generating a report across every
# profile at once (--format csv or --profile omitted), since otherwise
# there's no way to tell whose reading is whose in the output.
include_profile = no

# Unit to render the Weight column in: kg, lb, or st. Stored measurements
# are always in kilograms; this only affects report display.
weight_unit = kg

# Date/time format: us (MM/DD/YYYY, 12-hour) or world (DD/MM/YYYY, 24-hour)
date_format = world

# PDF page size: letter or a4
page_size = letter

# Print a min/max/average/net-change summary line for the Weight column
# below the title. Defaults to no.
include_summary = no

# Print a body composition snapshot (BMI, body fat %, muscle mass, etc.,
# via the upstream library's calculations) for the most recent reading
# that has impedance data. Requires --profile <name> / ?profile=<name> so
# the right person's biometrics get used -- see [profile.<name>] below.
# PDF only; has no effect on --format csv or --multi-scale reports (body
# metrics need one single profile to apply).
include_body_metrics = no

# Print a "Goal Progress" section (current weight, goal weight, remaining,
# and a rough projected days-to-goal from the rate of change across the
# report's range) for the selected --profile <name> / ?profile=<name>.
# Unlike include_body_metrics, a profile without goal_weight set (or no
# --profile given at all) just prints a note instead of erroring, since
# there's no correctness risk in simply not showing a goal. PDF only.
include_goal_progress = no

[mqtt]
# Publish each measurement to an MQTT broker as JSON. Defaults to no. A
# broker outage is logged and non-fatal -- it never blocks local recording.
enabled = no
# Required if enabled = yes.
host =
port = 1883
# Optional broker credentials; leave blank if not required.
username =
password =
# yes or no -- wraps the connection in TLS
use_tls = no
# Messages publish to <topic_prefix>/<scale address>/state
topic_prefix = etekcity_scale_daemon
# 0, 1, or 2
qos = 0
# yes or no -- whether the broker retains the last message for new subscribers
retain = yes

[alerting]
# Notify via Apprise (https://github.com/caronc/apprise) if a scale goes
# quiet or a weight changes a lot between consecutive readings. Checked by
# etekcity-scale-alert-check, run periodically (see
# etekcity-scale-alert-check.timer) -- nothing here runs automatically on
# its own. Defaults to no.
enabled = no
# Comma-separated Apprise service URLs, e.g. tgram://bot_token/chat_id.
# Required if enabled = yes.
apprise_urls =
# Alert if a scale hasn't reported in this many days. 0 disables this check.
stale_after_days = 0
# Alert if two consecutive readings differ by more than this many kg
# (always kg regardless of report.weight_unit). 0 disables this check.
weight_swing_threshold_kg = 0
# Where to persist per-scale alert state (throttling repeat alerts).
state_path = /var/lib/etekcity-scale-daemon/alert-state.json

[api]
# Lightweight local HTTP API (etekcity-scale-api): GET /api/v1/health,
# /api/v1/capabilities, /api/v1/latest, and /api/v1/report. Defaults to
# no. There's no TLS built in -- keep host bound to loopback (the
# default) unless it sits behind a reverse proxy.
enabled = no
# Bind address. Change to 0.0.0.0 (or a specific interface) only if you
# understand the exposure -- set token below if you do.
host = 127.0.0.1
port = 8080
# Optional bearer token: if set, all endpoints except /api/v1/health and
# /api/v1/capabilities require an "Authorization: Bearer <token>" header.
# Leave blank for no auth (fine for loopback-only use).
token =

[profiles]
# Ask "who was this?" for each reading, for a scale shared by more than
# one person. Defaults to no. Two delivery paths, chosen automatically:
#   - If [api] is enabled: an ntfy notification with one HTTP action
#     button per name below, each calling back into this API's
#     /api/v1/assign-profile endpoint when tapped. Needs ntfy_url set.
#   - If [api] is disabled: a local dunstify prompt instead, since ntfy's
#     action buttons would have nothing to call back to. Needs dunstify
#     (part of the dunst notification daemon) and a real desktop/D-Bus
#     session -- this won't reach anywhere from a headless system service
#     without one.
enabled = no
# Comma-separated list of names to choose between.
names =
# Required only when [api] is enabled: an ntfy topic URL, e.g.
# https://ntfy.sh/your-topic or a self-hosted https://ntfy.example.com/your-topic.
ntfy_url =
# Optional access token, if your ntfy server/topic requires auth.
ntfy_token =
# Where this API is reachable, for the ntfy action buttons to call back
# into. Only used when [api] is enabled.
api_base_url = http://127.0.0.1:8080
# Seconds to wait for a dunstify response before giving up. Only used
# when [api] is disabled.
dunstify_timeout_seconds = 30
# Reject /api/v1/assign-profile requests tagging a reading older than this many
# seconds, unless &confirm=1 is also passed. Guards against a delayed
# ntfy notification -- tapped long after it was sent, once connectivity
# returns -- silently tagging a now-stale reading. 0 disables the check
# (the default). Only relevant when [api] is enabled.
assign_window_seconds = 0

# One [profile.<name>] section per name listed in [profiles] names above:
# optional name/email printed below the title in PDF reports (e.g. for
# handing a report to a doctor -- leave either blank to omit that line),
# plus body-composition biometrics for report.include_body_metrics /
# etekcity-scale-report --profile <name> / the API's ?profile= filter.
# A missing or incomplete section is treated as an error for that profile
# rather than silently reusing another profile's height/sex.
#
# height_unit is the unit that the height value below is written in: m
# (meters), cm (centimeters), or in (inches). Defaults to m.
#
# skip_body_metrics = yes skips body composition entirely for this profile
# instead of requiring height/birthdate/sex -- useful when bioelectrical
# impedance readings aren't physiologically meaningful for this person
# (e.g. an amputee or anyone who can't complete the two-foot electrical
# path the scale relies on). Weight itself is unaffected either way.
#
# weight_unit (kg, lb, or st) overrides report.weight_unit for this
# profile's reports only -- leave blank to just use report.weight_unit.
# Handy when people sharing a scale think in different units.
#
# goal_weight_unit (kg, lb, or st; defaults to kg) is the unit that
# goal_weight below is written in, for report.include_goal_progress.
# Leave goal_weight blank to just not show goal progress for this profile.
#
# [profile.Alice]
# name = Alice Smith
# email = alice@example.com
# height_unit = m
# height = 1.65
# birthdate = 1990-04-12
# sex = female
# athlete = no
# goal_weight_unit = kg
# goal_weight = 62
#
# [profile.Bob]
# name = Bob Jones
# email = bob@example.com
# height_unit = in
# height = 70.9
# birthdate = 1988-11-02
# sex = male
# athlete = no
# weight_unit = lb
# goal_weight_unit = lb
# goal_weight = 180
#
# [profile.Charlie]
# name = Charlie Diaz
# skip_body_metrics = yes
